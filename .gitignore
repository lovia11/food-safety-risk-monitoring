.venv/
.browser-profile/
__pycache__/
*.py[cod]
.pytest_cache/
.cache/

# Runtime evidence and local browser state are generated per machine.
output/
archive/
# Canonical documentation archives are intentionally versioned.
!docs/archive/
!docs/archive/**
*.log

# Local SQLite business index (rebuildable from output run snapshots).
data/*.db
data/*.db-*
data/*.sqlite
data/*.sqlite-*

# PaddleOCR/PaddleX models and other downloaded model caches.
.paddleocr/
.paddlex/
models/
model_cache/

# A complete saved webpage creates a large resource folder; keep the HTML
# regression fixture but not its downloaded scripts and images.
manual_input/taobao_search_files/

# Local demo recordings are deliverables, not source code.
*.mp4

# Local secrets and editor/OS metadata.
.env
.env.*
.idea/
.vscode/
.DS_Store
Thumbs.db

# React workspace dependencies and production output.
frontend/node_modules/
frontend/dist/
